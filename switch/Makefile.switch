#---------------------------------------------------------------------------------
# xemu Nintendo Switch Port - Makefile
#
# This Makefile builds xemu for Nintendo Switch using devkitpro/libnx.
# It is a standalone build system separate from the main meson-based build.
#
# Requirements:
#   - devkitpro with devkitA64
#   - switch-sdl2
#   - switch-mesa (OpenGL 4.3)
#   - switch-glad
#   - switch-zlib
#   - switch-libpng
#
# Usage:
#   make -f switch/Makefile.switch
#   make -f switch/Makefile.switch clean
#   make -f switch/Makefile.switch nro
#
# SPDX-License-Identifier: GPL-2.0-or-later
#---------------------------------------------------------------------------------

#---------------------------------------------------------------------------------
# Environment
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=/opt/devkitpro")
endif

# Handle running from project root (make -f switch/Makefile.switch)
# or from switch directory (cd switch && make -f Makefile.switch)
ifneq ($(wildcard $(CURDIR)/switch/Makefile.switch),)
    # Running from project root
    TOPDIR ?= $(CURDIR)
else
    # Running from switch directory
    TOPDIR ?= $(CURDIR)/..
endif
include $(DEVKITPRO)/libnx/switch_rules

#---------------------------------------------------------------------------------
# Build configuration
#---------------------------------------------------------------------------------
APP_TITLE   := xemu
APP_AUTHOR  := xemu team
APP_VERSION := 0.1.0-switch
APP_ICON    := $(TOPDIR)/ui/icons/xemu_256x256.png

TARGET      := xemu
BUILD       := build-switch
OUTDIR      := $(TOPDIR)/dist-switch
SOURCES     := switch
INCLUDES    := switch include

#---------------------------------------------------------------------------------
# Compiler flags
#---------------------------------------------------------------------------------
ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE

CFLAGS := -g -Wall -O2 -ffunction-sections \
          $(ARCH) $(DEFINES)

CFLAGS += -DXBOX=1 \
          -DCONFIG_SWITCH=1 \
          -D__SWITCH__ \
          -DIMGUI_IMPL_OPENGL_LOADER_CUSTOM=1 \
          -include glad/glad.h \
          -D__BYTE_ORDER=1234 \
          -D_GNU_SOURCE \
          -DNEED_CPU_H \
          -DCOMPILING_PER_TARGET \
          -DCONFIG_TARGET=\"config-target.h\" \
          -include $(TOPDIR)/switch/config-switch.h \
          -include $(TOPDIR)/switch/platform_stubs.h \
          -include $(TOPDIR)/switch/glib-compat.h

CXXFLAGS := $(CFLAGS) -fno-rtti -fexceptions -std=c++17

ASFLAGS := -g $(ARCH)

LDFLAGS := -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) \
           -Wl,-Map,$(notdir $*.map)

#---------------------------------------------------------------------------------
# Libraries
#---------------------------------------------------------------------------------
# Note: Order matters for linking. glad must come before EGL/GL libs.
LIBS_FULL := -lglad -lSDL2 -lEGL -lglapi -ldrm_nouveau \
             -lnx -lm -lpthread
LIBS_MINIMAL := -lnx -lm
LIBS := $(LIBS_FULL)

#---------------------------------------------------------------------------------
# Include paths and library paths
#---------------------------------------------------------------------------------
LIBDIRS := $(PORTLIBS) $(LIBNX)
LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

# Build directory first for generated config headers
# NATIVE_BUILD points to the existing x86 build directory for QAPI generated files
NATIVE_BUILD := $(TOPDIR)/build

INCLUDE := -I$(BUILD) \
           -I$(TOPDIR)/switch \
           -I$(TOPDIR)/switch/sys \
           -I$(TOPDIR) \
           -I$(TOPDIR)/include \
           -I$(TOPDIR)/host/include/aarch64 \
           -I$(TOPDIR)/host/include/generic \
           -I$(NATIVE_BUILD) \
           -I$(NATIVE_BUILD)/qapi \
           -I$(TOPDIR)/target/i386 \
           -I$(TOPDIR)/tcg/i386 \
           -I$(TOPDIR)/tcg/aarch64 \
           -I$(TOPDIR)/tcg \
           -I$(TOPDIR)/accel/tcg \
           -I$(TOPDIR)/hw/xbox \
           -I$(TOPDIR)/ui \
           -I$(TOPDIR)/ui/xui \
           -I$(TOPDIR)/ui/thirdparty \
           -I$(TOPDIR)/ui/thirdparty/noc_file_dialog \
           -I$(TOPDIR)/ui/thirdparty/fpng \
           -I$(TOPDIR)/subprojects/imgui \
           -I$(TOPDIR)/subprojects/imgui/backends \
           -I$(TOPDIR)/subprojects/implot \
           -I$(TOPDIR)/ui/thirdparty/stb_image \
           -I$(TOPDIR)/ui/thirdparty/fa \
           -I$(TOPDIR)/subprojects/tomlplusplus/include \
           -I$(TOPDIR)/subprojects/genconfig \
           -I$(TOPDIR)/subprojects/json-3.2.0/include \
           $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
           $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
           -I$(DEVKITPRO)/portlibs/switch/include/SDL2

#---------------------------------------------------------------------------------
# Source files - Phase 1: Minimal bootstrap
#---------------------------------------------------------------------------------

# Switch-specific sources
SWITCH_SRCS := \
