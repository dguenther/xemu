# Crypto sources (minimal)
CRYPTO_SRCS := \
    crypto/init.c \
    crypto/hash.c \
    crypto/hmac.c \
    crypto/aes.c \
    crypto/random-platform.c

# Block layer sources (minimal for ISO loading)
BLOCK_SRCS := \
    block.c \
    block/raw-format.c \
    block/file-posix.c \
    block/qcow2.c \
    block/io.c \
    blockjob.c

# HW base sources
HW_BASE_SRCS := \
