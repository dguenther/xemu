    hw/core/qdev-properties.c \
    hw/core/bus.c \
    hw/core/resettable.c \
    hw/core/clock.c \
    hw/core/irq.c \
    hw/core/sysbus.c \
    hw/core/machine.c

# Xbox HW sources
XBOX_HW_SRCS := \
