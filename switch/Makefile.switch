    hw/xbox/nv2a/prmvio.c \
    hw/xbox/nv2a/ptimer.c \
    hw/xbox/nv2a/pvideo.c \
    hw/xbox/nv2a/user.c \
    hw/xbox/nv2a/debug.c \
    hw/xbox/nv2a/pgraph/pgraph.c \
    hw/xbox/nv2a/pgraph/surface.c \
    hw/xbox/nv2a/pgraph/texture.c \
    hw/xbox/nv2a/pgraph/vertex.c \
    hw/xbox/nv2a/pgraph/shaders.c \
    hw/xbox/nv2a/pgraph/swizzle.c \
    hw/xbox/nv2a/pgraph/gl/display.c \
    hw/xbox/nv2a/pgraph/gl/renderer.c \
