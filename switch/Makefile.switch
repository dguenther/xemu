# Combine sources
ALL_SRCS := \
    $(SWITCH_SRCS) \
    $(IMGUI_SRCS) \
    $(IMPLOT_SRCS) \
    $(FPNG_SRCS) \
    $(UI_SRCS)

# Full emulator build (Phase 9: boot to BIOS)
ifeq ($(SWITCH_FULL),1)
ALL_SRCS := \
    $(SWITCH_SRCS) \
    $(IMGUI_SRCS) \
    $(IMPLOT_SRCS) \
    $(FPNG_SRCS) \
    $(UI_SRCS) \
    $(UI_SRCS_FULL) \
    $(UI_SRCS_STUBS) \
    $(UTIL_SRCS) \
    $(CHARDEV_SRCS) \
    $(ACCEL_SRCS) \
    $(CPU_SRCS) \
    $(QOM_SRCS) \
    $(QAPI_SRCS) \
    $(QOBJECT_SRCS) \
    $(CRYPTO_SRCS) \
    $(BLOCK_SRCS) \
    $(HW_BASE_SRCS) \
    $(PCI_SRCS) \
    $(SEMI_SRCS) \
    $(XBOX_HW_SRCS) \
    $(AUDIO_SRCS) \
    $(TCG_SRCS) \
    $(MEMORY_SRCS) \
    $(TARGET_I386_SRCS) \
    $(TRACE_SRCS) \
    $(SYSTEM_SRCS)
endif

# Minimal bootstrap build: only the Switch entry point (Phase 1)
ifeq ($(SWITCH_BOOTSTRAP),1)
ALL_SRCS := switch/main-switch.c switch/oslib-switch.c switch/glib-compat.c $(wildcard switch/qemu-stubs/*.c)
LIBS := $(LIBS_FULL)
endif

# Full emulator build would include all of these (Phase 3):
# $(UTIL_SRCS) $(QOM_SRCS) $(QOBJECT_SRCS) $(CRYPTO_SRCS)
# $(BLOCK_SRCS) $(HW_BASE_SRCS) $(XBOX_HW_SRCS)
# $(AUDIO_SRCS) $(TCG_SRCS) $(MEMORY_SRCS) $(TARGET_I386_SRCS)

#---------------------------------------------------------------------------------
# Object files
#---------------------------------------------------------------------------------
CFILES   := $(filter %.c,$(ALL_SRCS))
CCFILES  := $(filter %.cc,$(ALL_SRCS))
CPPFILES := $(filter %.cpp,$(ALL_SRCS))
SFILES   := $(filter %.s,$(ALL_SRCS))

# Convert source paths to object paths
OFILES_C   := $(addprefix $(BUILD)/,$(CFILES:.c=.o))
OFILES_CC  := $(addprefix $(BUILD)/,$(CCFILES:.cc=.o))
OFILES_CPP := $(addprefix $(BUILD)/,$(CPPFILES:.cpp=.o))
OFILES_S   := $(addprefix $(BUILD)/,$(SFILES:.s=.o))
OFILES     := $(OFILES_C) $(OFILES_CC) $(OFILES_CPP) $(OFILES_S)
DFILES     := $(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# Build rules
#---------------------------------------------------------------------------------
.PHONY: all clean nro directories

all: directories $(OUTDIR)/$(TARGET).elf

nro: $(OUTDIR)/$(TARGET).nro

directories:
	@mkdir -p $(BUILD)
	@mkdir -p $(OUTDIR)
	@mkdir -p $(dir $(OFILES))

#---------------------------------------------------------------------------------
# Generated headers - Create config-host.h and config-target.h wrappers
#---------------------------------------------------------------------------------
GENERATED_HEADERS := $(BUILD)/config-host.h $(BUILD)/config-target.h

$(BUILD)/config-host.h: $(TOPDIR)/switch/config-switch.h
	@mkdir -p $(BUILD)
	@echo "Generating $@..."
	@echo "/* Auto-generated config-host.h for Switch build */" > $@
	@echo "#ifndef CONFIG_HOST_H" >> $@
	@echo "#define CONFIG_HOST_H" >> $@
	@echo "#include \"$(TOPDIR)/switch/config-switch.h\"" >> $@
	@echo "#endif" >> $@

$(BUILD)/config-target.h: $(TOPDIR)/switch/config-switch.h
	@mkdir -p $(BUILD)
	@echo "Generating $@..."
	@echo "/* Auto-generated config-target.h for Switch build */" > $@
	@echo "#ifndef CONFIG_TARGET_H" >> $@
	@echo "#define CONFIG_TARGET_H" >> $@
	@echo "/* i386 target configuration */" >> $@
	@echo "#define TARGET_NAME \"i386\"" >> $@
	@echo "#define TARGET_I386 1" >> $@
	@echo "#define TARGET_LONG_BITS 32" >> $@
	@echo "#define TARGET_INSN_START_EXTRA_WORDS 1" >> $@
	@echo "#define TARGET_PAGE_BITS 12" >> $@
	@echo "#define TARGET_PHYS_ADDR_SPACE_BITS 36" >> $@
	@echo "#define TARGET_VIRT_ADDR_SPACE_BITS 32" >> $@
	@echo "#define TARGET_BIG_ENDIAN 0" >> $@
	@echo "#define CONFIG_SOFTMMU 1" >> $@
	@echo "#include \"$(TOPDIR)/switch/config-switch.h\"" >> $@
	@echo "#endif" >> $@

generated-headers: $(GENERATED_HEADERS)

$(OUTDIR)/$(TARGET).nro: $(OUTDIR)/$(TARGET).elf
	@mkdir -p $(OUTDIR)
	@elf2nro $< $@ \
		--icon=$(APP_ICON) \
		--nacp=$(BUILD)/$(TARGET).nacp

$(BUILD)/$(TARGET).nacp:
	@mkdir -p $(BUILD)
	@nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(OUTDIR)/$(TARGET).elf: $(OFILES) $(BUILD)/$(TARGET).nacp
	@echo "Linking $@..."
	@mkdir -p $(OUTDIR)
	@$(CXX) $(LDFLAGS) $(OFILES) $(LIBPATHS) $(LIBS) -o $@
	@echo "Built $@"

$(BUILD)/%.o: $(TOPDIR)/%.c $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CC) -MMD -MP -MF $(BUILD)/$*.d $(CFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.cc $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CXX) -MMD -MP -MF $(BUILD)/$*.d $(CXXFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.cpp $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CXX) -MMD -MP -MF $(BUILD)/$*.d $(CXXFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.s
	@echo "Assembling $<..."
	@mkdir -p $(dir $@)
	@$(CC) -MMD -MP -MF $(BUILD)/$*.d -x assembler-with-cpp $(ASFLAGS) -c $< -o $@

clean:
	@echo "Cleaning..."
	@rm -rf $(BUILD) $(OUTDIR)

#---------------------------------------------------------------------------------
# Dependencies
#---------------------------------------------------------------------------------
-include $(DFILES)

#---------------------------------------------------------------------------------
# Debugging targets
#---------------------------------------------------------------------------------
.PHONY: print-sources

print-sources:
	@echo "=== Source files ==="
	@for f in $(ALL_SRCS); do echo "  $$f"; done
	@echo "=== Object files ==="
	@for f in $(OFILES); do echo "  $$f"; done
