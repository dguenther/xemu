    switch/oslib-switch.c \
    switch/glib-compat.c \
    switch/qemu-stubs.c \
    switch/egl-switch.c \
    switch/noc_file_dialog_switch.c \
    switch/stb_image_impl.c \
    switch/cpp-stubs.cc \
    build/data/logo_sdf.png.c

# Core QEMU utility sources
# Note: util/osdep.c and util/memalign.c are excluded - oslib-switch.c provides Switch versions
UTIL_SRCS := \
    util/cutils.c \
    util/unicode.c \
    util/error.c \
    util/error-report.c \
    util/qemu-print.c \
    util/bitmap.c \
    util/bitops.c \
    util/host-utils.c \
    util/log.c \
    util/crc32c.c \
    util/uuid.c \
    util/range.c \
    util/fifo8.c \
    util/cacheflush.c \
    util/int128.c \
    util/notify.c \
    util/id.c \
    util/path.c \
    util/envlist.c \
    util/module.c \
    util/qemu-option.c \
    util/qemu-config.c \
    util/keyval.c \
    util/guest-random.c \
    util/interval-tree.c \
    util/lockcnt.c \
    util/rcu.c \
    util/qht.c \
    util/qdist.c \
    util/qsp.c \
    util/stats64.c \
    util/reserved-region.c \
