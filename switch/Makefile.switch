# ImGui sources
IMGUI_SRCS := \
    subprojects/imgui/imgui.cpp \
    subprojects/imgui/imgui_demo.cpp \
    subprojects/imgui/imgui_draw.cpp \
    subprojects/imgui/imgui_tables.cpp \
    subprojects/imgui/imgui_widgets.cpp \
    subprojects/imgui/backends/imgui_impl_sdl2.cpp \
    subprojects/imgui/backends/imgui_impl_opengl3.cpp \
    subprojects/imgui/misc/cpp/imgui_stdlib.cpp

# ImPlot sources
IMPLOT_SRCS := \
    subprojects/implot/implot.cpp \
    subprojects/implot/implot_items.cpp

# fpng sources (for screenshot/PNG encoding)
FPNG_SRCS := \
    ui/thirdparty/fpng/fpng.cpp

# UI sources (xemu-specific)
UI_SRCS := \
    ui/xemu-settings.cc \
    ui/xui/main.cc \
    ui/xui/main-menu.cc \
    ui/xui/gl-helpers.cc \
    ui/xui/widgets.cc \
    ui/xui/viewport-manager.cc \
    ui/xui/scene-manager.cc \
    ui/xui/scene.cc \
    ui/xui/scene-components.cc \
    ui/xui/popup-menu.cc \
    ui/xui/actions.cc \
    ui/xui/welcome.cc \
    ui/xui/notifications.cc \
    ui/xui/monitor.cc \
    ui/xui/font-manager.cc \
    ui/xui/input-manager.cc \
    ui/xui/snapshot-manager.cc \
    ui/xui/reporting.cc \
    ui/xui/animation.cc \
    ui/xui/menubar.cc \
    ui/input.c \
    ui/kbd-state.c \
    ui/keymaps.c

# Audio sources (SDL only)
AUDIO_SRCS := \
    audio/audio.c \
    audio/mixeng.c \
    audio/noaudio.c \
    audio/wavaudio.c \
    audio/sdlaudio.c

# TCG sources
TCG_SRCS := \
    accel/tcg/tcg-all.c \
    accel/tcg/cpu-exec.c \
    accel/tcg/cpu-exec-common.c \
    accel/tcg/translate-all.c \
    accel/tcg/translator.c \
    accel/tcg/cputlb.c \
    tcg/tcg.c \
    tcg/tcg-op.c \
    tcg/tcg-op-vec.c \
    tcg/optimize.c \
    tcg/tcg-common.c \
    fpu/softfloat.c

# Memory sources
MEMORY_SRCS := \
    system/memory.c \
    system/physmem.c \
    system/ioport.c \
    system/dma-helpers.c \
    system/cpus.c \
    system/cpu-timers.c \
    system/vl.c \
    system/runstate.c \
    system/reset.c \
    system/qemu-seccomp.c \
    system/globals.c \
    system/watchpoint.c \
    system/main.c

# i386 target sources
TARGET_I386_SRCS := \
    target/i386/cpu.c \
    target/i386/cpu-param.c \
    target/i386/gdbstub.c \
    target/i386/helper.c \
    target/i386/xsave_helper.c \
    target/i386/tcg/translate.c \
    target/i386/tcg/cc_helper.c \
    target/i386/tcg/excp_helper.c \
    target/i386/tcg/fpu_helper.c \
    target/i386/tcg/int_helper.c \
    target/i386/tcg/mem_helper.c \
    target/i386/tcg/misc_helper.c \
    target/i386/tcg/seg_helper.c \
    target/i386/tcg/svm_helper.c \
    target/i386/tcg/bpt_helper.c \
    target/i386/tcg/mpx_helper.c

# Combine all sources for UI-only build (Phase 2: HUD integration)
ALL_SRCS := \
    $(SWITCH_SRCS) \
    $(IMGUI_SRCS) \
    $(IMPLOT_SRCS) \
    $(FPNG_SRCS) \
    $(UI_SRCS)

# Minimal bootstrap build: only the Switch entry point (Phase 1)
ifeq ($(SWITCH_BOOTSTRAP),1)
ALL_SRCS := switch/main-switch.c switch/oslib-switch.c switch/glib-compat.c switch/qemu-stubs.c
LIBS := $(LIBS_FULL)
endif

# Full emulator build would include all of these (Phase 3):
# $(UTIL_SRCS) $(QOM_SRCS) $(QOBJECT_SRCS) $(CRYPTO_SRCS)
# $(BLOCK_SRCS) $(HW_BASE_SRCS) $(XBOX_HW_SRCS)
# $(AUDIO_SRCS) $(TCG_SRCS) $(MEMORY_SRCS) $(TARGET_I386_SRCS)

#---------------------------------------------------------------------------------
# Object files
#---------------------------------------------------------------------------------
CFILES   := $(filter %.c,$(ALL_SRCS))
CCFILES  := $(filter %.cc,$(ALL_SRCS))
CPPFILES := $(filter %.cpp,$(ALL_SRCS))
SFILES   := $(filter %.s,$(ALL_SRCS))

# Convert source paths to object paths
OFILES_C   := $(addprefix $(BUILD)/,$(CFILES:.c=.o))
OFILES_CC  := $(addprefix $(BUILD)/,$(CCFILES:.cc=.o))
OFILES_CPP := $(addprefix $(BUILD)/,$(CPPFILES:.cpp=.o))
OFILES_S   := $(addprefix $(BUILD)/,$(SFILES:.s=.o))
OFILES     := $(OFILES_C) $(OFILES_CC) $(OFILES_CPP) $(OFILES_S)
DFILES     := $(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# Build rules
#---------------------------------------------------------------------------------
.PHONY: all clean nro directories

all: directories $(OUTDIR)/$(TARGET).elf

nro: $(OUTDIR)/$(TARGET).nro

directories:
	@mkdir -p $(BUILD)
	@mkdir -p $(OUTDIR)
	@mkdir -p $(dir $(OFILES))

#---------------------------------------------------------------------------------
# Generated headers - Create config-host.h and config-target.h wrappers
#---------------------------------------------------------------------------------
GENERATED_HEADERS := $(BUILD)/config-host.h $(BUILD)/config-target.h

$(BUILD)/config-host.h: $(TOPDIR)/switch/config-switch.h
	@mkdir -p $(BUILD)
	@echo "Generating $@..."
	@echo "/* Auto-generated config-host.h for Switch build */" > $@
	@echo "#ifndef CONFIG_HOST_H" >> $@
	@echo "#define CONFIG_HOST_H" >> $@
	@echo "#include \"$(TOPDIR)/switch/config-switch.h\"" >> $@
	@echo "#endif" >> $@

$(BUILD)/config-target.h: $(TOPDIR)/switch/config-switch.h
	@mkdir -p $(BUILD)
	@echo "Generating $@..."
	@echo "/* Auto-generated config-target.h for Switch build */" > $@
	@echo "#ifndef CONFIG_TARGET_H" >> $@
	@echo "#define CONFIG_TARGET_H" >> $@
	@echo "/* i386 target configuration */" >> $@
	@echo "#define TARGET_NAME \"i386\"" >> $@
	@echo "#define TARGET_I386 1" >> $@
	@echo "#define TARGET_LONG_BITS 32" >> $@
	@echo "#define TARGET_INSN_START_EXTRA_WORDS 1" >> $@
	@echo "#define TARGET_PAGE_BITS 12" >> $@
	@echo "#define TARGET_PHYS_ADDR_SPACE_BITS 36" >> $@
	@echo "#define TARGET_VIRT_ADDR_SPACE_BITS 32" >> $@
	@echo "#undef TARGET_BIG_ENDIAN" >> $@
	@echo "#define CONFIG_SOFTMMU 1" >> $@
	@echo "#include \"$(TOPDIR)/switch/config-switch.h\"" >> $@
	@echo "#endif" >> $@

generated-headers: $(GENERATED_HEADERS)

$(OUTDIR)/$(TARGET).nro: $(OUTDIR)/$(TARGET).elf
	@mkdir -p $(OUTDIR)
	@elf2nro $< $@ \
		--icon=$(APP_ICON) \
		--nacp=$(BUILD)/$(TARGET).nacp

$(BUILD)/$(TARGET).nacp:
	@mkdir -p $(BUILD)
	@nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(OUTDIR)/$(TARGET).elf: $(OFILES) $(BUILD)/$(TARGET).nacp
	@echo "Linking $@..."
	@mkdir -p $(OUTDIR)
	@$(CXX) $(LDFLAGS) $(OFILES) $(LIBPATHS) $(LIBS) -o $@
	@echo "Built $@"

$(BUILD)/%.o: $(TOPDIR)/%.c $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CC) -MMD -MP -MF $(BUILD)/$*.d $(CFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.cc $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CXX) -MMD -MP -MF $(BUILD)/$*.d $(CXXFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.cpp $(GENERATED_HEADERS)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	@$(CXX) -MMD -MP -MF $(BUILD)/$*.d $(CXXFLAGS) $(INCLUDE) -c $< -o $@

$(BUILD)/%.o: $(TOPDIR)/%.s
	@echo "Assembling $<..."
	@mkdir -p $(dir $@)
	@$(CC) -MMD -MP -MF $(BUILD)/$*.d -x assembler-with-cpp $(ASFLAGS) -c $< -o $@

clean:
	@echo "Cleaning..."
	@rm -rf $(BUILD) $(OUTDIR)

#---------------------------------------------------------------------------------
# Dependencies
#---------------------------------------------------------------------------------
-include $(DFILES)

#---------------------------------------------------------------------------------
# Debugging targets
#---------------------------------------------------------------------------------
.PHONY: print-sources

print-sources:
	@echo "=== Source files ==="
	@for f in $(ALL_SRCS); do echo "  $$f"; done
	@echo "=== Object files ==="
	@for f in $(OFILES); do echo "  $$f"; done
